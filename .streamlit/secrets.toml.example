[app]
mode = "demo" # "snowflake" only after server-side connection is configured
[snowflake]
account = "YOUR_ORG-YOUR_ACCOUNT"
user = "PUBLIC_DEMO_READER"
warehouse = "CF_DEMO_WH"
role = "CF_DEMO_READER"
authenticator = "SNOWFLAKE_JWT"
# Paste PEM only into host secrets, never GitHub:
private_key_pem = """-----BEGIN PRIVATE KEY-----
REPLACE_IN_HOST_SECRET_SETTINGS_ONLY
-----END PRIVATE KEY-----"""
